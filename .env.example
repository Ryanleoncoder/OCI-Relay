# ═══════════════════════════════════════════════════════════════════════════
#  OCI Relay — configuração
#  Copie para .env e preencha. O .env nunca vai para o git.
# ═══════════════════════════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────────────────────────────
# Token: fale com @BotFather e envie /newbot
TELEGRAM_BOT_TOKEN=

# Seu ID numérico: fale com @userinfobot. Aceita vários, separados por vírgula.
# Se ficar vazio, QUALQUER pessoa que achar o bot poderá usá-lo.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── OCI: modo de autenticação ─────────────────────────────────────────────
# true  = Instance Principal. Só funciona rodando DENTRO da instância OCI:
#         o signer busca um certificado no serviço de metadados da máquina.
#         É o modo recomendado em produção — nenhuma chave fica em disco.
# false = API Key. Use para rodar do seu PC. Exige os 4 campos abaixo.
#
# Atenção: uma API Key herda as permissões do SEU usuário. Se você é
# administrador da tenancy, o bot também será.
OCI_USE_INSTANCE_PRINCIPAL=true

# ── OCI: API Key (só quando OCI_USE_INSTANCE_PRINCIPAL=false) ─────────────
# Console → avatar (canto superior direito) → Meu perfil → Chaves de API
# → Adicionar chave de API → Gerar par de chaves → BAIXE a chave privada
# ANTES de clicar em Adicionar (depois não dá mais) → Adicionar.
# Os 3 primeiros valores aparecem na "Visualização do arquivo de configuração".
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=

# Caminho da chave .pem baixada. Aceita ~ para o diretório do usuário.
OCI_PRIVATE_KEY_PATH=~/.oci/oci_api_key.pem

# ── OCI: recurso monitorado (obrigatório nos dois modos) ──────────────────
# Identificador da região, não o nome de exibição: sa-saopaulo-1, us-ashburn-1
OCI_REGION=

# Console → ☰ → Compute → Instâncias → sua VPS → OCID → Copiar
# Começa com "ocid1.instance." — se começar com "ocid1.tenancy." é o valor
# errado. O Relay valida isso no startup e avisa.
OCI_INSTANCE_OCID=

# Onde a instância vive. No compartimento root é igual ao OCI_TENANCY_OCID.
# Usado pelas consultas de métricas e de custo.
OCI_COMPARTMENT_OCID=

# ── Caminhos (opcionais) ──────────────────────────────────────────────────
# Sobrescrevem a raiz inferida do pacote. Úteis no deploy via systemd, onde
# o código não fica na árvore do repositório.
# OCI_RELAY_HOME=
# OCI_RELAY_ENV_FILE=
# OCI_RELAY_STATE_DIR=

# ── Alertas (ainda não implementados; os limiares já colorem os painéis) ──
ALERTS_ENABLED=true

# Custo: o free tier deve ficar em zero. Qualquer valor acima merece olhada.
ALERT_COST_WARNING_USD=0.10
ALERT_COST_CRITICAL_USD=1.00

# CPU: a janela existe para não alertar em pico de poucos segundos.
ALERT_CPU_WARNING_PERCENT=85
ALERT_CPU_CRITICAL_PERCENT=95
ALERT_CPU_WINDOW_MINUTES=15

ALERT_MEMORY_WARNING_PERCENT=85
ALERT_MEMORY_CRITICAL_PERCENT=95

ALERT_DISK_WARNING_PERCENT=80
ALERT_DISK_CRITICAL_PERCENT=95

# Ataque SSH: alerta por volume numa janela, não por IP isolado.
ALERT_ATTACK_FAILURES=100
ALERT_ATTACK_WINDOW_MINUTES=10

# ── Serviços ──────────────────────────────────────────────────────────────
# Unidades systemd consideradas críticas, separadas por vírgula. Elas aparecem
# com semáforo no /services e definem o veredito do painel.
CRITICAL_SERVICES=ssh,docker,fail2ban

# ── Watchers ──────────────────────────────────────────────────────────────
# Avisar a cada login SSH bem-sucedido. Barulhento se você acessa muito.
WATCH_SSH_LOGINS=false

# ── Discord (opcional, só para alertas) ───────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
